{
  "name": "ai-workflow-creator-system",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:batch": "node scripts/generate-batch.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npx --yes hyperframes@0.6.79 lint && npx --yes hyperframes@0.6.79 validate && npx --yes hyperframes@0.6.79 inspect",
    "render": "PATH=./node_modules/ffmpeg-static:./node_modules/ffprobe-static/bin/darwin/arm64:./node_modules/ffprobe-static/bin/darwin/x64:$PATH npx --yes hyperframes@0.6.79 render --output renders/ai-architect-douyin.mp4 --quality standard",
    "dev": "npx --yes hyperframes@0.6.79 preview"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "gsap": "^3.15.0"
  }
}
